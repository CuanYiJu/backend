# ── Login (magic-link) ─────────────────────────────────────────────
# HMAC key for links, codes and session cookies. At least 32 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MAGIC_LINK_SECRET=

# Public origin the browser uses. In dev this is the Vite dev server, which
# proxies /api and /auth to this backend. https required except localhost.
APP_BASE_URL=http://localhost:5173

# From header for login mail. Domain needs SPF / DKIM / DMARC in Resend.
EMAIL_FROM=开局 <login@example.com>

# Mail provider for login emails: Mailjet (free 6,000/month) when both keys
# are set; else Resend when RESEND_API_KEY is set; else printed to the terminal.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
RESEND_API_KEY=

# ── App ────────────────────────────────────────────────────────────
# Group admins (comma separated emails). They can create a profile without
# being on the name list, and they manage the list of members' WeChat names
# at /admin. Everyone else must type a WeChat name that is on that list.
ADMIN_EMAILS=you@example.com

# SQLite database file (created on first start). ":memory:" for throwaway.
DATABASE_FILE=./data/kaiju.sqlite

# Set to 1 behind a reverse proxy / Vercel / Cloudflare so X-Forwarded-For is trusted.
TRUST_PROXY=0

# Serve a built frontend (site/frontend/dist) from this process in production.
STATIC_DIR=

PORT=8787

# End-to-end tests only (site/qa): keep login mail in memory, expose it at
# GET /api/_test/mail?to=... and disable login rate limits. Refused in production.
E2E_MAILBOX=0
